{
  "uid": "fairgate-overview",
  "title": "FairGate Overview",
  "tags": [
    "fairgate"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Active TCP Connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "fairgate_tcp_connections_active",
          "legendFormat": "active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Events per Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(fairgate_events_accepted_total[1m])",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "expr": "rate(fairgate_events_rejected_total[1m])",
          "legendFormat": "rate limited",
          "refId": "B"
        },
        {
          "expr": "rate(fairgate_events_invalid_total[1m])",
          "legendFormat": "invalid",
          "refId": "C"
        },
        {
          "expr": "rate(fairgate_events_processed_total[1m])",
          "legendFormat": "processed",
          "refId": "D"
        }
      ]
    },
    {
      "id": 3,
      "title": "WAL Append Errors",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "increase(fairgate_wal_append_errors_total[$__range])",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Shipper Lag",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "expr": "fairgate_shipper_lag_bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Fullest Queue",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "fairgate_queue_fill_ratio_max",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Firing Alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "job": true
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Ingestion",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "Ingest Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fairgate_ingest_duration_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fairgate_ingest_duration_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Duplicates and Conflicts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "rate(fairgate_events_duplicate_total[1m])",
          "legendFormat": "duplicate retries",
          "refId": "A"
        },
        {
          "expr": "sum(rate(fairgate_producer_events_total{outcome=\"conflict\"}[1m]))",
          "legendFormat": "identity conflicts",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Fairness",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Events Processed per Producer",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (producer) (rate(fairgate_producer_events_processed_total[1m]))",
          "legendFormat": "{{producer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Queue Depth per Producer",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "fairgate_producer_queue_depth_events",
          "legendFormat": "{{producer}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Rate-Limited Events per Producer",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "expr": "sum by (producer) (rate(fairgate_producer_events_total{outcome=\"rate_limited\"}[1m]))",
          "legendFormat": "{{producer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Queue Fill",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "expr": "fairgate_queue_fill_ratio_max",
          "legendFormat": "fullest queue",
          "refId": "A"
        },
        {
          "expr": "fairgate_queue_depth_events",
          "legendFormat": "queued events (all producers)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 15,
      "title": "Write-Ahead Log",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "id": 16,
      "title": "WAL Append and Fsync Latency (p99)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fairgate_wal_append_duration_seconds_bucket[1m])))",
          "legendFormat": "append (incl. group commit)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fairgate_wal_sync_duration_seconds_bucket[1m])))",
          "legendFormat": "fsync",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Group Commit Size",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "rate(fairgate_wal_group_commit_records_sum[1m]) / rate(fairgate_wal_group_commit_records_count[1m])",
          "legendFormat": "records per fsync (avg)",
          "refId": "A"
        },
        {
          "expr": "rate(fairgate_wal_group_commit_records_count[1m])",
          "legendFormat": "fsyncs per second",
          "refId": "B"
        }
      ]
    },
    {
      "id": 18,
      "title": "WAL Disk Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "fairgate_wal_disk_bytes",
          "legendFormat": "bytes on disk",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "title": "WAL Segments",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "expr": "fairgate_wal_segments",
          "legendFormat": "segments on disk",
          "refId": "A"
        },
        {
          "expr": "increase(fairgate_wal_segment_rotations_total[5m])",
          "legendFormat": "rotations (5m)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 20,
      "title": "Shipper",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "panels": []
    },
    {
      "id": 21,
      "title": "Delivery Lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "targets": [
        {
          "expr": "fairgate_shipper_lag_bytes",
          "legendFormat": "undelivered WAL bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "title": "Shipped Events and Insert Failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "targets": [
        {
          "expr": "rate(fairgate_shipper_events_total[1m])",
          "legendFormat": "events shipped",
          "refId": "A"
        },
        {
          "expr": "rate(fairgate_shipper_insert_failures_total[1m])",
          "legendFormat": "insert failures",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "title": "Insert Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 65
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fairgate_shipper_insert_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fairgate_shipper_insert_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "title": "Time Since Last Checkpoint",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 65
      },
      "targets": [
        {
          "expr": "time() - fairgate_shipper_last_checkpoint_timestamp_seconds",
          "legendFormat": "since checkpoint",
          "refId": "A"
        },
        {
          "expr": "fairgate_shipper_consecutive_failures",
          "legendFormat": "consecutive failures",
          "refId": "B"
        }
      ]
    },
    {
      "id": 25,
      "title": "Go Runtime",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 73
      },
      "panels": []
    },
    {
      "id": 26,
      "title": "Goroutines and CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 74
      },
      "targets": [
        {
          "expr": "go_goroutines{job=\"fairgate\"}",
          "legendFormat": "goroutines",
          "refId": "A"
        },
        {
          "expr": "rate(process_cpu_seconds_total{job=\"fairgate\"}[1m])",
          "legendFormat": "CPU cores",
          "refId": "B"
        }
      ]
    },
    {
      "id": 27,
      "title": "Memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 74
      },
      "targets": [
        {
          "expr": "go_memstats_heap_alloc_bytes{job=\"fairgate\"}",
          "legendFormat": "heap in use",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"fairgate\"}",
          "legendFormat": "resident",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ]
}
